\str_new:N  \l__ns_text_str
\tl_new:N   \l__ns_current_tl
\tl_new:N   \l__ns_next_tl
\tl_new:N   \l__ns_following_tl
\tl_new:N   \l__ns_pair_tl
\tl_new:N   \l__ns_glyph_tl
\tl_new:N   \l__ns_slot_tl
\int_new:N  \l__ns_position_int
\int_new:N  \l__ns_length_int
\cs_generate_variant:Nn \prop_get:NnNTF { NV }
\cs_generate_variant:Nn \prop_get:NnNT { NV }
\cs_new_protected:Npn \__ns_emit_glyph:n #1
  {
    \prop_get:NnNTF \g__ns_slots_prop {#1} \l__ns_slot_tl
      { \tex_char:D \l__ns_slot_tl \scan_stop: }
          {
        \PackageWarning{newsikretek}{Unsupported~glyph~'#1';~using~fallback}
        \group_begin: \normalfont #1 \group_end:
      }
  }
\cs_generate_variant:Nn \__ns_emit_glyph:n { V }
\cs_new_protected:Npn \__ns_shape:n #1
  {
    \str_set:Nx \l__ns_text_str { \tl_to_str:n {#1} }
    \int_set:Nn \l__ns_length_int { \str_count:N \l__ns_text_str }
    \int_set:Nn \l__ns_position_int { 1 }
    \int_while_do:nn { \l__ns_position_int <= \l__ns_length_int }
      {
        \tl_set:Nx \l__ns_current_tl
          { \str_item:Nn \l__ns_text_str { \l__ns_position_int } }
        \tl_set:Nx \l__ns_next_tl
          { \str_item:Nn \l__ns_text_str { \int_eval:n { \l__ns_position_int + 1 } } }
        \tl_set:Nx \l__ns_following_tl
          { \str_item:Nn \l__ns_text_str { \int_eval:n { \l__ns_position_int + 2 } } }
        \str_if_eq:VnTF \l__ns_current_tl { ~ }
          { \tex_space:D \int_incr:N \l__ns_position_int }
          {
            \tl_set:Nx \l__ns_pair_tl { \l__ns_current_tl \l__ns_next_tl }
            \prop_get:NVNTF \g__ns_lig_prop \l__ns_pair_tl \l__ns_glyph_tl
              {
                \str_if_eq:VnT \l__ns_following_tl { ~ }
                  {
                    \prop_get:NVNT \g__ns_final_pair_prop
                      \l__ns_pair_tl \l__ns_glyph_tl { }
                  }
                \__ns_emit_glyph:V \l__ns_glyph_tl
                \int_add:Nn \l__ns_position_int {2}
              }
              {
                \tl_set_eq:NN \l__ns_glyph_tl \l__ns_current_tl
                \str_if_eq:VnT \l__ns_next_tl { ~ }
                  {
                    \prop_get:NVNT \g__ns_final_single_prop
                      \l__ns_current_tl \l__ns_glyph_tl { }
                  }
                \__ns_emit_glyph:V \l__ns_glyph_tl
                \int_incr:N \l__ns_position_int
              }
          }
      }
  }
% Use this command for fully shaped text. The argument should contain literal text.
\NewDocumentCommand{\sikretek}{s m}
  {
    \group_begin:
      \leavevmode
      \fontencoding{U}\fontfamily{newsikretek}\fontseries{m}\fontshape{n}\selectfont
      \IfBooleanTF{#1}
        { \__ns_shape:n {#2 ~} \tex_unskip:D }
        { \__ns_shape:n {#2} }
    \group_end:
  }
